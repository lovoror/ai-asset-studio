# Copy to .env (this file is the live config). No secrets belong here except an optional API token.
STUDIO_GPU_UUID=GPU-52b50765-57a3-0ed4-78c9-4fa54276f65d
STUDIO_API_PORT=8090
STUDIO_BIND=127.0.0.1
# Set to require a bearer token on all /v1 endpoints (mandatory if STUDIO_BIND is not localhost)
STUDIO_API_TOKEN=
# 1 = workers never contact the network after prefetch
HF_HUB_OFFLINE=1

# Optional: folder with extra single-file models in ComfyUI layout (diffusion_models/, text_encoders/)
STUDIO_EXTRA_MODELS_DIR=
